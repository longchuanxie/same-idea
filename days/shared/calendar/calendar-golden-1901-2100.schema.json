{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "calendar-golden-1901-2100.schema.json",
  "title": "Anniversary Calendar Golden 1901-2100",
  "type": "object",
  "required": ["version", "range", "ruleVersion", "ruleChecksum", "checksum", "days"],
  "properties": {
    "$schema": { "type": "string" },
    "version": { "const": "calendar-golden-1.0.0" },
    "range": {
      "type": "object",
      "required": ["start", "end"],
      "properties": {
        "start": { "const": "1901-01-01" },
        "end": { "const": "2100-12-31" }
      },
      "additionalProperties": false
    },
    "ruleVersion": { "const": "lunar-rules-1.0.0" },
    "ruleChecksum": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "source": { "type": "object" },
    "checksum": {
      "type": "object",
      "required": ["algorithm", "dataSha256"],
      "properties": {
        "algorithm": { "const": "SHA-256" },
        "dataSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "additionalProperties": false
    },
    "days": {
      "type": "array",
      "minItems": 73049,
      "maxItems": 73049,
      "items": {
        "type": "object",
        "required": [
          "gregorian",
          "lunarYear",
          "lunarMonth",
          "lunarDay",
          "isLeapMonth",
          "lunarMonthDays",
          "lunarDisplay"
        ],
        "properties": {
          "gregorian": { "type": "string", "format": "date" },
          "lunarYear": { "type": "integer", "minimum": 1900, "maximum": 2100 },
          "lunarMonth": { "type": "integer", "minimum": 1, "maximum": 12 },
          "lunarDay": { "type": "integer", "minimum": 1, "maximum": 30 },
          "isLeapMonth": { "type": "boolean" },
          "lunarMonthDays": { "type": "integer", "enum": [29, 30] },
          "lunarDisplay": { "type": "string" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
